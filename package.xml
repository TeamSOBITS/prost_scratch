<?xml version="1.0"?>
<package format="3">
  <name>prost_scratch</name>
  <version>0.0.0</version>
  <description>The prost_scratch package for ROS2 Jazzy - TurtleBot2 control with Scratch integration</description>

  <maintainer email="sobit-x2@todo.todo">sobit-x2</maintainer>
  <license>TODO</license>

  <!-- ROS2 build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Python setuptools for ament_python packages -->
  <build_depend>ament_cmake_python</build_depend>
  
  <!-- ROS2 dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_py</depend>
  
  <!-- TurtleBot2/Kobuki dependencies for ROS2 -->
  <depend>turtlebot3_msgs</depend>
  
  <!-- Additional dependencies -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>