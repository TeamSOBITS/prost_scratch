<!--
  Robot description only (used in private and paired master).
 -->
<launch>
  <arg name="base"/>
  <arg name="stacks"/>
  <arg name="3d_sensor"/>

  <!-- following file is the model file -->
  <arg name="urdf_file" default="$(find xacro)/xacro.py '$(find prostbot_description)/robots/kobuki_hexagons_asus_xtion_pro_offset.urdf.xacro'" />
  <param name="robot_description" command="$(arg urdf_file)" />

</launch>
